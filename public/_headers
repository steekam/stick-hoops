# Cloudflare Pages headers. Hashed build files never change, so browsers keep them for a year;
# the page and the service worker are always revalidated so a release shows up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
