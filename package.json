{
  "name": "stick-hoops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview && node scripts/artifact.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "3.2.4"
  }
}
